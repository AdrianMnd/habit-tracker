DATABASE_URL=jdbc:postgresql://TU_HOST_DE_NEON/TU_DB?sslmode=require
DATABASE_USERNAME=tu_usuario
DATABASE_PASSWORD=tu_password

CORS_ALLOWED_ORIGINS=http://localhost:5173

GEMINI_API_KEY=tu_clave_de_gemini

# Genera una clave aleatoria de al menos 32 caracteres, por ejemplo con:
# [System.Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SECRET=tu_clave_secreta_aleatoria_de_al_menos_32_caracteres


# Web Push: genera el par con "npx web-push generate-vapid-keys" (una sola vez)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@email.com


# Secreto del cron de recordatorios (cualquier cadena aleatoria larga, igual que JWT_SECRET)
CRON_SECRET=